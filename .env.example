# Variables d'environnement - Sales AI Agent
# Copier ce fichier en .env et remplir les valeurs
# Générer une valeur forte pour SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Application ────────────────────────────────────────
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me-with-a-long-random-string
# Token bootstrap pour /api/auth/register (>= 32 caractères)
ADMIN_BOOTSTRAP_TOKEN=change-me-admin-bootstrap-token

# ── Base de données PostgreSQL ──────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sales_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── Redis & Celery ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM (OpenAI & Ollama Qwen) ─────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Base modele recommandé (qwen2.5:7b-instruct ~= 4.7 GB; qwen2.5:1.5b ~= 1.1 GB)
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Agent Vocal (STT & TTS) ────────────────────────────
STT_ENGINE=faster_whisper
STT_MODEL_SIZE=small
STT_VAD_ENGINE=silero_vad
TTS_ENGINE=edge_tts
TTS_FALLBACK_ENGINE=piper
TTS_PIPER_MODEL_PATH=models/piper/ar_MA-medium.onnx
TTS_VOICE_DARIJA=ar-MA-MounaNeural
TTS_VOICE_FRENCH=fr-FR-HenriNeural

# ── Calendar (Google / Outlook) ────────────────────────
# Tokens OAuth2 Bearer dédiés (NE PLUS UTILISER SECRET_KEY)
GOOGLE_CALENDAR_TOKEN=
OUTLOOK_TOKEN=

# ── Qdrant (RAG) ───────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── HubSpot ────────────────────────────────────────────
HUBSPOT_API_KEY=

# ── Odoo ───────────────────────────────────────────────
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your_db
ODOO_USER=admin
ODOO_PASSWORD=

# ── Email SMTP ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASSWORD=
SMTP_SECURE=true
FROM_EMAIL=noreply@yourcompany.com

# ── WhatsApp Business API ──────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── LinkedIn ───────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=

# ── B2B Intelligence APIs (optionnels, free tiers) ─────
# Apollo.io: 10 000 credits/mois gratuits
APOLLO_API_KEY=
# Hunter.io: 25 calls/mois gratuits
HUNTER_API_KEY=
# Snov.io: 50 credits/mois gratuits
SNOVIO_API_KEY=
# Bing Search: 1000 calls/mois gratuits
BING_SEARCH_API_KEY=

# ── Langfuse (LLM tracing) ─────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── OpenTelemetry ──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sales-agent-api

# ── Frontend (Next.js) ─────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

DATABASE_URL=sqlite:///osmos.db
SECRET_KEY=osmos-secret-key-change-in-production
# Mettre à true pour activer l'extraction réelle via le Hub (localhost:8000)
USE_REAL_ACTIONNEUR=false

# LLM utilisé par les moteurs internes (search_engine, llm_engine, persona_engine, plan_engine).
# "ollama" (défaut, nécessite ollama serve + qwen3:8b en local) ou "groq".
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

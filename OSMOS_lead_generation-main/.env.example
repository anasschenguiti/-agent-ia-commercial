# No API keys required for local Ollama usage.
# OLLAMA_URL=http://127.0.0.1:11434 (default)

# Optional: Use OpenAI or Anthropic directly instead
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Choix du provider LLM pour l'agent de navigation
# Valeurs possibles : "ollama" (par défaut) ou "groq"
# Changez en 'groq' pour tester Groq (nécessite GROQ_API_KEY)
# LLM_PROVIDER=ollama

# Configuration Groq (seulement si LLM_PROVIDER=groq)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
